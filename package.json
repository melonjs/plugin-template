{
  "name": "plugin-template",
  "version": "3.0.0",
  "description": "melonJS plugin template",
  "homepage": "https://github.com/melonjs/plugin-template#readme",
  "type": "module",
  "keywords": [
    "2D",
    "HTML5",
    "javascript",
    "TypeScript",
    "es6",
    "melonjs",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melonjs/plugin-template.git"
  },
  "bugs": {
    "url": "https://github.com/melonjs/plugin-template/issues"
  },
  "license": "MIT",
  "author": "Olivier Biot (AltByte Pte Ltd)",
  "funding": "https://github.com/sponsors/melonjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "melonjs": ">=20.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "melonjs": "^20.11.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "dev": "concurrently --raw \"npm run build:watch\" \"npm run types:watch\"",
    "build": "tsx scripts/build.ts && npm run types",
    "build:watch": "tsx scripts/build.ts watch",
    "types": "tsc --project tsconfig.build.json",
    "types:watch": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:types": "tsc",
    "clean": "tsx scripts/clean.ts",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "overrides": {
    "vitest": "^4.1.11",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11"
  }
}
